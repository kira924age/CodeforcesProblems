{
  "name": "codeforces-problems-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --max-warnings=0",
    "lint:fix": "vp lint --fix --max-warnings=0",
    "analyze:build": "npm run build -- --mode analyze",
    "analyze": "npm run analyze:build && vp preview --outDir .bundle-analysis --host 127.0.0.1 --port 8888 --strictPort"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^27.0.0",
    "rollup-plugin-visualizer": "7.1.2",
    "sass": "^1.32.8",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  }
}
